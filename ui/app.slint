import { Theme, UISize, Images, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Callbacks } from "callbacks.slint";
import { Button } from "@ui/button.slint";
import { PremiumSlide } from "premium_slide.slint";
import { Input } from "@ui/input.slint";

export { Callbacks, Theme, Images, ControlSize }

export struct Glyph { color: color, shape: int }
export struct AgentRow { name: string, fp: string }
export struct Recent { title: string, agent: string, approved: bool, when: string }

// Trusted frame: only app-rendered content (paired name, risk, summary, action code, glyphs, expiry)
// is ever drawn inside one. Agent free text (title, details) lives in the scroll area between them.
component TrustedFrame inherits Rectangle {
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.palette-muted.transparentize(0.55);
    background: Theme.palette-muted.transparentize(0.94);
}

// The pairing code, drawn by the app inside a trusted frame. Same code on the agent's screen.
component PairCode inherits TrustedFrame {
    in property <string> code;
    VerticalLayout {
        padding: 12px; spacing: 4px;
        Text { text: "PAIRING CODE"; horizontal-alignment: center; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-caption; font-weight: Theme.font-weight-semibold; letter-spacing: 1.5px; }
        Text { text: root.code; horizontal-alignment: center; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: 28px; font-weight: Theme.font-weight-bold; letter-spacing: 3px; }
    }
}

// Foundation's own warning amber, used only for the elevated-risk band.
global Brand {
    out property <color> amber: #d97706;
    out property <color> ok: #16a34a;
}

component Label inherits Text {
    color: Theme.palette-muted;
    font-family: Theme.font-primary;
    font-size: Theme.font-size-caption;
    font-weight: Theme.font-weight-semibold;
    letter-spacing: 1.5px;
}

component Body inherits Text {
    color: Theme.palette-foreground;
    font-family: Theme.font-primary;
    font-size: Theme.font-size-body;
    wrap: word-wrap;
}

component Mark inherits Rectangle {
    in property <bool> good: true;
    in property <length> size: 24px;
    width: self.size; height: self.size;
    border-radius: self.size / 2;
    background: self.good ? Brand.ok : Theme.palette-danger;
    Image {
        width: root.size * 0.6; height: root.size * 0.6;
        source: root.good ? @image-url("../resources/images/mark-check.svg") : @image-url("../resources/images/mark-cross.svg");
        colorize: white;
    }
}

export component AppWindow inherits Window {
    title: "Prime Approve";
    preferred-width: UISize.screen-width;
    preferred-height: UISize.screen-height;
    background: Theme.palette-background;

    // 0 home, 1 review, 2 reply, 3 error, 4 deny reason, 5 unpair prompt, 6 pair confirm, 7 paired reply
    in-out property <int> page: 0;
    in property <bool> show-dev: false;
    // Demo builds only (cargo feature "demo"): a demo agent with a public key is paired.
    in property <bool> demo-mode: false;
    in property <string> agent-name: "";
    in property <[AgentRow]> agents: [];
    in property <bool> has-agent: true;

    // Pairing (pages 6 and 7). pair-name is typed by the person; blank means pair-default.
    in-out property <string> pair-name: "";
    in property <string> pair-default: "Agent 1";
    in property <string> pair-error: "";
    in property <string> pair-fp: "";
    in property <string> pair-code: "";
    in property <bool> pair-repair: false;
    in property <string> app-key-line: "";
    in property <[Recent]> recents: [];

    in property <bool> elevated: false;
    in property <string> req-title: "";
    in property <string> req-details: "";
    in property <string> action-code: "";
    // App-built from the structured verb/object/target fields; "" when the request has none.
    in property <string> summary-line: "";
    in property <[Glyph]> glyphs: [];
    in property <string> expires-line: "";
    in-out property <bool> read-to-end: false;

    in property <bool> approved: false;
    in property <image> reply-qr;
    in property <string> qr-line: "";

    in property <string> error-title: "";
    in property <string> error-body: "";
    in property <string> error-next: "";

    VerticalLayout {
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-md + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-lg;

        // Shown on every screen of a demo build: anyone can sign as the demo agent.
        if root.demo-mode: Rectangle {
            height: 32px;
            border-radius: 8px;
            background: Theme.palette-danger;
            Text { text: "DEMO KEY · NOT SECURE"; color: white; font-family: Theme.font-primary; font-size: Theme.font-size-caption; font-weight: Theme.font-weight-semibold; letter-spacing: 1.5px; horizontal-alignment: center; vertical-alignment: center; }
        }

        // ---------- Home ----------
        if root.page == 0: VerticalLayout {
            spacing: Theme.spacing-lg;
            Label { text: "PRIME APPROVE"; horizontal-alignment: center; }
            Button {
                width: 100%; full-width: true; size: ControlSize.lg;
                min-button-height: 112px; font-size: Theme.font-size-title;
                text: "Scan code";
                clicked => { Callbacks.scan-request(); }
            }
            if root.demo-mode: HorizontalLayout {
                spacing: Theme.spacing-sm;
                Button { size: ControlSize.md; variant: ButtonVariant.secondary; horizontal-stretch: 1; text: "Demo request"; clicked => { Callbacks.scan-demo(); } }
                Button { size: ControlSize.md; variant: ButtonVariant.secondary; horizontal-stretch: 1; text: "Demo pair"; clicked => { Callbacks.scan-demo-pair(); } }
            }
            VerticalLayout {
                spacing: Theme.spacing-sm;
                Label { text: root.agents.length > 1 ? "PAIRED AGENTS" : "PAIRED AGENT"; }
                // Tap an agent to unpair it.
                for ag[i] in root.agents: TouchArea {
                    height: 30px;
                    clicked => { Callbacks.manage-agent(i); }
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        Body { text: ag.name; font-weight: Theme.font-weight-semibold; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; vertical-alignment: center; }
                        Body { text: ag.fp; color: Theme.palette-muted; horizontal-stretch: 0; wrap: no-wrap; vertical-alignment: center; }
                        Body { text: "›"; color: Theme.palette-muted; horizontal-stretch: 0; vertical-alignment: center; }
                    }
                }
                if !root.has-agent: Body { text: "No agent paired. Scan your agent's pairing code."; color: Theme.palette-muted; }
            }
            VerticalLayout {
                spacing: Theme.spacing-sm;
                vertical-stretch: 1;
                Label { text: "RECENT DECISIONS"; }
                if root.recents.length == 0: Body { text: "Nothing yet. Requests you answer show up here."; color: Theme.palette-muted; }
                // Scrolls instead of squeezing the buttons when there are many agents and decisions.
                rf := Flickable {
                    vertical-stretch: 1;
                    viewport-height: rlist.preferred-height;
                    rlist := VerticalLayout {
                        width: rf.width;
                        alignment: start;
                        spacing: Theme.spacing-sm;
                        for r in root.recents: HorizontalLayout {
                            spacing: Theme.spacing-md;
                            VerticalLayout { alignment: center; Mark { good: r.approved; size: 22px; } }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Body { text: r.title; wrap: no-wrap; overflow: elide; }
                                Body { text: r.agent + " · " + r.when; color: Theme.palette-muted; font-size: Theme.font-size-caption; wrap: no-wrap; overflow: elide; }
                            }
                        }
                    }
                }
            }
            if root.show-dev: VerticalLayout {
                spacing: Theme.spacing-xs;
                Label { text: "DEMO BUILD · SECURITY TESTS"; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    Button { text: "Tampered"; size: ControlSize.sm; variant: ButtonVariant.secondary; horizontal-stretch: 1; clicked => { Callbacks.scan-tampered(); } }
                    Button { text: "Replay"; size: ControlSize.sm; variant: ButtonVariant.secondary; horizontal-stretch: 1; clicked => { Callbacks.scan-replay(); } }
                    Button { text: "Hidden text"; size: ControlSize.sm; variant: ButtonVariant.secondary; horizontal-stretch: 1; clicked => { Callbacks.scan-hidden(); } }
                }
            }
            Text { text: root.app-key-line; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-xs; horizontal-alignment: center; }
        }

        // ---------- Review ----------
        if root.page == 1: VerticalLayout {
            spacing: Theme.spacing-md;
            Rectangle {
                height: 48px;
                border-radius: 12px;
                background: root.elevated ? Brand.amber : Theme.palette-muted.transparentize(0.85);
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Text { text: root.agent-name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                        color: root.elevated ? white : Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-body; font-weight: Theme.font-weight-semibold; }
                    Text { text: root.elevated ? "High impact · paired" : "paired"; vertical-alignment: center;
                        color: root.elevated ? white : Brand.ok; font-family: Theme.font-primary; font-size: Theme.font-size-caption; font-weight: Theme.font-weight-semibold; }
                    VerticalLayout { alignment: center;
                        Image { width: 18px; height: 18px; source: @image-url("../resources/images/mark-check.svg"); colorize: root.elevated ? white : Brand.ok; }
                    }
                }
            }
            fl := Flickable {
                vertical-stretch: 1;
                viewport-height: body.preferred-height;
                property <bool> at-end: self.viewport-height <= self.height + 2px || -self.viewport-y >= self.viewport-height - self.height - 4px;
                changed at-end => { if (self.at-end) { root.read-to-end = true; } }
                init => { if (self.at-end) { root.read-to-end = true; } }
                body := VerticalLayout {
                    width: fl.width;
                    spacing: Theme.spacing-sm;
                    Text { text: root.req-title; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; wrap: word-wrap; }
                    Body { text: root.req-details; }
                    Label { text: "END OF REQUEST"; horizontal-alignment: center; }
                }
            }
            TrustedFrame {
                VerticalLayout {
                    padding: 10px; spacing: 2px;
                    if root.summary-line != "": Text {
                        text: root.summary-line; horizontal-alignment: center; wrap: word-wrap;
                        color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-body; font-weight: Theme.font-weight-semibold;
                    }
                    if root.summary-line != "": Rectangle { height: 1px; background: Theme.palette-muted.transparentize(0.7); }
                    Label { text: "ACTION CODE"; horizontal-alignment: center; }
                    Text { text: root.action-code; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: 34px; font-weight: Theme.font-weight-bold; letter-spacing: 3px; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 8px; padding-top: 4px; padding-bottom: 4px;
                        for g in root.glyphs: Rectangle {
                            width: 32px; height: 32px;
                            border-radius: (g.shape == 0 || g.shape == 2) ? 16px : 5px;
                            background: (g.shape == 0 || g.shape == 1) ? g.color : transparent;
                            border-width: (g.shape == 2 || g.shape == 3) ? 6px : 0px;
                            border-color: g.color;
                        }
                    }
                    Text { text: root.expires-line; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-label; horizontal-alignment: center; }
                }
            }
            Text { text: root.read-to-end ? "Check this code matches your agent." : "Scroll to the end to unlock."; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-label; horizontal-alignment: center; wrap: word-wrap; }
            PremiumSlide { width: 100%; vertical-stretch: 0; hint: "Slide to approve"; done-hint: "Approved"; disabled: !root.read-to-end; activated => { Callbacks.approve(); } }
            Button { width: 100%; text: "Deny"; variant: ButtonVariant.ghost; full-width: true; clicked => { Callbacks.deny(); } }
        }

        // ---------- Signed reply ----------
        if root.page == 2: VerticalLayout {
            spacing: Theme.spacing-md;
            HorizontalLayout { alignment: center; Mark { good: root.approved; size: 72px; } }
            Text { text: root.approved ? "Approved" : "Denied"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; horizontal-alignment: center; }
            Text { text: root.action-code; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-md; letter-spacing: 3px; horizontal-alignment: center; }
            HorizontalLayout { alignment: center;
                Rectangle { width: 300px; height: 300px; background: white; border-radius: 12px;
                    Image { width: 284px; height: 284px; source: root.reply-qr; image-rendering: pixelated; }
                }
            }
            Body { text: "Show this to your agent."; horizontal-alignment: center; font-weight: Theme.font-weight-semibold; }
            Text { text: root.qr-line; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-xs; horizontal-alignment: center; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            Button { width: 100%; text: "Done"; size: ControlSize.lg; full-width: true; clicked => { Callbacks.done(); } }
        }

        // ---------- Rejected ----------
        if root.page == 3: VerticalLayout {
            spacing: Theme.spacing-md;
            Rectangle { height: 24px; }
            HorizontalLayout { alignment: center; Mark { good: false; size: 72px; } }
            Text { text: root.error-title; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; horizontal-alignment: center; wrap: word-wrap; }
            Body { text: root.error-body; horizontal-alignment: center; color: Theme.palette-muted; }
            Body { text: root.error-next; horizontal-alignment: center; font-weight: Theme.font-weight-semibold; }
            Label { text: "NOTHING WAS SIGNED"; horizontal-alignment: center; }
            Rectangle { vertical-stretch: 1; }
            Button { width: 100%; text: "Back"; size: ControlSize.lg; full-width: true; clicked => { Callbacks.done(); } }
        }

        // ---------- Deny reason ----------
        if root.page == 4: VerticalLayout {
            spacing: Theme.spacing-md;
            Rectangle { height: 24px; }
            Text { text: "Why deny?"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; horizontal-alignment: center; }
            Body { text: "Optional. Your agent will see your answer."; color: Theme.palette-muted; horizontal-alignment: center; }
            Rectangle { height: 8px; }
            Button { width: 100%; full-width: true; text: "Wrong action"; variant: ButtonVariant.secondary; clicked => { Callbacks.deny-with("wrong_action"); } }
            Button { width: 100%; full-width: true; text: "Not now"; variant: ButtonVariant.secondary; clicked => { Callbacks.deny-with("not_now"); } }
            Button { width: 100%; full-width: true; text: "Don't recognize this"; variant: ButtonVariant.secondary; clicked => { Callbacks.deny-with("unrecognized"); } }
            Rectangle { vertical-stretch: 1; }
            Button { width: 100%; full-width: true; text: "Skip"; variant: ButtonVariant.ghost; clicked => { Callbacks.deny-with(""); } }
        }

        // ---------- Unpair prompt ----------
        if root.page == 5: VerticalLayout {
            spacing: Theme.spacing-md;
            Rectangle { height: 24px; }
            Text { text: "Unpair this agent?"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; horizontal-alignment: center; }
            Body { text: root.agent-name + " won't be able to send you requests until you pair it again. This is saved, so it stays unpaired after a restart."; color: Theme.palette-muted; horizontal-alignment: center; }
            Rectangle { vertical-stretch: 1; }
            PremiumSlide { width: 100%; vertical-stretch: 0; hint: "Slide to unpair"; done-hint: "Unpaired"; accent: Theme.palette-danger; activated => { Callbacks.unpair(true); } }
            Button { width: 100%; full-width: true; text: "Keep paired"; variant: ButtonVariant.ghost; clicked => { Callbacks.unpair(false); } }
        }
    
        // ---------- Pair confirm ----------
        // The frame holds only app-computed values (pairing code, key fingerprint). The offer carries
        // no name: the person names the agent here.
        if root.page == 6: VerticalLayout {
            spacing: Theme.spacing-md;
            Label { text: root.pair-repair ? "PAIRED BEFORE" : "NEW AGENT"; horizontal-alignment: center; }
            Text { text: root.pair-repair ? "Pair this agent again?" : "Pair this agent?"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; horizontal-alignment: center; }
            PairCode { code: root.pair-code; }
            Text { text: "Agent key " + root.pair-fp; color: Theme.palette-muted; font-family: Theme.font-primary; font-size: Theme.font-size-label; horizontal-alignment: center; }
            Body { text: "Pair only if your agent shows this same code."; horizontal-alignment: center; font-weight: Theme.font-weight-semibold; }
            Label { text: "NAME THIS AGENT"; }
            Input {
                width: 100%;
                height: self.preferred-height;
                vertical-stretch: 0;
                placeholder: root.pair-default;
                value <=> root.pair-name;
                error: root.pair-error;
                clearable: true;
                submitted => { Callbacks.pair-confirm(root.pair-name); }
            }
            Rectangle { vertical-stretch: 1; }
            Button { width: 100%; text: "Pair"; size: ControlSize.lg; full-width: true; clicked => { Callbacks.pair-confirm(root.pair-name); } }
            Button { width: 100%; text: "Cancel"; variant: ButtonVariant.ghost; full-width: true; clicked => { Callbacks.pair-cancel(); } }
        }

        // ---------- Paired: answer QR for the agent ----------
        if root.page == 7: VerticalLayout {
            spacing: Theme.spacing-md;
            HorizontalLayout { alignment: center; spacing: Theme.spacing-sm;
                VerticalLayout { alignment: center; Mark { good: true; size: 28px; } }
                Text { text: "Paired with " + root.agent-name; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-bold; vertical-alignment: center; overflow: elide; }
            }
            HorizontalLayout { alignment: center;
                Rectangle { width: 300px; height: 300px; background: white; border-radius: 12px;
                    Image { width: 284px; height: 284px; source: root.reply-qr; image-rendering: pixelated; }
                }
            }
            PairCode { code: root.pair-code; }
            Body { text: "Show this to your agent. Check this code matches your agent."; horizontal-alignment: center; font-weight: Theme.font-weight-semibold; }
            Rectangle { vertical-stretch: 1; }
            Button { width: 100%; text: "Done"; size: ControlSize.lg; full-width: true; clicked => { Callbacks.done(); } }
        }
    }
}
